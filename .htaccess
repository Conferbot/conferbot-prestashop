# Deny direct HTTP access to the module's PHP files. PrestaShop includes them
# itself; nothing in this module is meant to be requested directly.
# Apache 2.2
<IfModule !mod_authz_core.c>
    <Files *.php>
    Order allow,deny
    Deny from all
    </Files>
</IfModule>
# Apache 2.4
<IfModule mod_authz_core.c>
    <Files *.php>
    Require all denied
    </Files>
</IfModule>
